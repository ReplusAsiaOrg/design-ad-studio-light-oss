# デモモード（1 にすると Meta API・DB なしで架空の化粧品ブランドのサンプルデータで動く。`npm run demo` と同じ）
# DEMO_MODE=1

# Meta Graph API（ads_read権限のアクセストークン）
META_ACCESS_TOKEN=

# 画像生成・vision分類・テキスト生成フォールバック
OPENAI_API_KEY=

# テキスト・分析（設定するとGeminiを優先使用）
GEMINI_API_KEY=

# Geminiモデルの上書き（任意。既定: テキスト gemini-flash-latest / 画像 gemini-3-pro-image）
# GEMINI_TEXT_MODEL=
# GEMINI_IMAGE_MODEL=

# 画像生成（PoYo経由エンジン・任意）
POYO_API_KEY=

# ローカルPostgres接続文字列（任意。未設定時は data/ads/*.json にフォールバック）
DATABASE_URL=
