.netlify

# Playwright MCP のテスト成果物
.playwright-mcp/

# ローカル広告データ（Meta同期結果・Privateだが履歴churn回避）
/data/

# 使い方マニュアルのビルド成果物（docs/site/build.mjs で生成）
docs/site/dist/
